{
  "name": "ayloul-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Website für AYLOUL (أيلول), Architektur und Grafikdesign, Homs",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "bilder": "node scripts/bilder.mjs",
    "bilder:extrahieren": "node scripts/extrahiere-bilder.mjs && node scripts/extrahiere-logo.mjs",
    "test": "node tests/alle.mjs",
    "pruefen": "astro build && node tests/alle.mjs",
    "screenshots": "node tests/screenshots.mjs",
    "portfolio": "gs -q -dNOPAUSE -dBATCH -sDEVICE=pdfwrite -dPDFSETTINGS=/ebook -dCompatibilityLevel=1.6 -sOutputFile=public/downloads/AYLOUL-Portfolio.pdf quelle/AYLOUL-Portfolio.pdf"
  },
  "dependencies": {
    "@fontsource-variable/fustat": "^5.3.0",
    "astro": "^7.4.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.1"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
