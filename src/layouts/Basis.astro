---
import '@fontsource-variable/fustat';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, richtung, sprachen, standardSprache, pfadIn, type Sprache } from '../i18n/utils';

interface Props { lang: Sprache; titel: string; beschreibung: string; seite?: string; ohneSuffix?: boolean; ohneAlternativen?: boolean }
const { lang, titel, beschreibung, seite = '', ohneSuffix = false, ohneAlternativen = false } = Astro.props;
const alternativen = sprachen.length > 1 && !ohneAlternativen;
const tx = t(lang);
const voller = ohneSuffix ? titel : `${titel} | ${tx.meta.titelSuffix}`;
const pfadJetzt = Astro.url.pathname;
---
<!doctype html>
<html lang={lang} dir={richtung(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{voller}</title>
    <meta name="description" content={beschreibung} />
    <meta name="theme-color" content="#052f24" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {alternativen && sprachen.map((s) => <link rel="alternate" hreflang={s} href={pfadIn(pfadJetzt, s)} />)}
    {alternativen && <link rel="alternate" hreflang="x-default" href={pfadIn(pfadJetzt, standardSprache)} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="zum-inhalt" href="#inhalt">{tx.nav.zumInhalt}</a>
    <Header lang={lang} seite={seite} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/basis.ts';
    </script>
  </body>
</html>
