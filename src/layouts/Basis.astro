---
import '@fontsource-variable/fustat';
import '../styles/tokens.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import manifest from '../data/bilder-manifest.json';
// Arabische Schrift früh laden (gleiche Datei wie im CSS von @fontsource): verhindert Layoutsprünge beim Schriftwechsel
import schriftArabisch from '@fontsource-variable/fustat/files/fustat-arabic-wght-normal.woff2?url';
import { t, richtung, sprachen, standardSprache, pfadIn, type Sprache } from '../i18n/utils';

interface Props { lang: Sprache; titel: string; beschreibung: string; seite?: string; ohneSuffix?: boolean; ohneAlternativen?: boolean; kopfUeberHero?: boolean; vorladen?: { id: string; sizes: string } }
const { lang, titel, beschreibung, seite = '', ohneSuffix = false, ohneAlternativen = false, kopfUeberHero = false, vorladen } = Astro.props;
// Größtes Bild der ersten Ansicht früh laden (LCP)
const vorBild = vorladen ? (manifest as Record<string, { varianten: { breite: number; avif: string }[] }>)[vorladen.id] : null;
const alternativen = sprachen.length > 1 && !ohneAlternativen;
const tx = t(lang);
const voller = ohneSuffix ? titel : `${titel} | ${tx.meta.titelSuffix}`;
const pfadJetzt = Astro.url.pathname;
---
<!doctype html>
<html lang={lang} dir={richtung(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{voller}</title>
    <meta name="description" content={beschreibung} />
    <meta name="theme-color" content="#052f24" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {lang === 'ar' && <link rel="preload" as="font" type="font/woff2" href={schriftArabisch} crossorigin="anonymous" />}
    {vorBild && vorladen && <link rel="preload" as="image" type="image/avif" fetchpriority="high" imagesrcset={vorBild.varianten.map((v) => `${v.avif} ${v.breite}w`).join(', ')} imagesizes={vorladen.sizes} />}
    {alternativen && sprachen.map((s) => <link rel="alternate" hreflang={s} href={pfadIn(pfadJetzt, s)} />)}
    {alternativen && <link rel="alternate" hreflang="x-default" href={pfadIn(pfadJetzt, standardSprache)} />}
    <script is:inline data-astro-rerun>document.documentElement.classList.add('js');</script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="zum-inhalt" href="#inhalt">{tx.nav.zumInhalt}</a>
    <Header lang={lang} seite={seite} ueberHero={kopfUeberHero} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
