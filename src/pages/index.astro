---
// "/" leitet auf die Standardsprache (/ar/) weiter. Ohne canonical, weil es (noch) keine Domain gibt.
import { pfad, standardSprache, sprachen } from '../i18n/utils';
const ziel = pfad(standardSprache);
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>أيلول | AYLOUL</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${ziel}`} />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <p><a href={ziel}>أيلول</a>{sprachen.includes('en') && <> | <a href="/en/" hreflang="en" lang="en">AYLOUL</a></>}</p>
  </body>
</html>
