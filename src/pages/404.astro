---
// 404-Seite in beiden Sprachen (Designsprache der Startseite): Hero mit Bild, "404" als Kicker, Titel, Knöpfe;
// darunter die weiteren Sprachen als heller Abschnitt.
import Basis from '../layouts/Basis.astro';
import Hero from '../components/sections/Hero.astro';
import Raute from '../components/Raute.astro';
import { altText } from '../data/daten';
import { t, pfad, sprachen, standardSprache, richtung } from '../i18n/utils';

const tx = t(standardSprache);
const weitere = sprachen.filter((s) => s !== standardSprache);
const heroBild = 'mosque-square-nacht-eingang';
---
<Basis lang={standardSprache} titel={tx.meta.seiten.fehler404.titel} beschreibung={tx.meta.seiten.fehler404.beschreibung} seite="" ohneAlternativen kopfUeberHero vorladen={{ id: heroBild, sizes: '100vw' }}>
  <Hero bild={heroBild} bildAlt={altText(heroBild, standardSprache)} kicker="404" titel={tx.fehler404.titel} unterzeile={tx.fehler404.text} hoehe="gross">
    <a class="knopf knopf-voll" href={pfad(standardSprache)}>{tx.fehler404.start}</a>
    <a class="knopf knopf-linie" href={pfad(standardSprache, 'projects')}>{tx.fehler404.projekte}</a>
  </Hero>
  {weitere.map((s) => {
    const w = t(s);
    return (
      <section class="abschnitt hell andere" lang={s} dir={richtung(s)} aria-labelledby={`fehler-${s}`}>
        <div class="huelle">
          <h2 id={`fehler-${s}`} class="andere-titel"><Raute />{w.fehler404.titel}</h2>
          <p class="einleitung">{w.fehler404.text}</p>
          <div class="knopf-reihe">
            <a class="knopf knopf-voll" href={pfad(s)}>{w.fehler404.start}</a>
            <a class="knopf knopf-linie" href={pfad(s, 'projects')}>{w.fehler404.projekte}</a>
          </div>
        </div>
      </section>
    );
  })}
</Basis>

<style>
  .andere-titel { display: flex; gap: var(--abstand-4); align-items: baseline; font-size: var(--h2); color: var(--farbe-terrakotta-dunkel); margin-block-end: var(--abstand-4); }
  .andere-titel :global(.raute) { inline-size: 0.5em; }
  .knopf-reihe { margin-block-start: var(--abstand-6); }
</style>
