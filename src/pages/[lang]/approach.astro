---
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Abschnittskopf from '../../components/Abschnittskopf.astro';
import Ablauf from '../../components/Ablauf.astro';
import Kontaktaufruf from '../../components/Kontaktaufruf.astro';
import { t, pfad, sprachPfade, type Sprache } from '../../i18n/utils';

export const getStaticPaths = sprachPfade;
const lang = Astro.params.lang as Sprache;
const tx = t(lang);
const a = tx.arbeitsweise;
---
<Basis lang={lang} titel={tx.meta.seiten.arbeitsweise.titel} beschreibung={tx.meta.seiten.arbeitsweise.beschreibung} seite="arbeitsweise">
  <Seitenkopf titel={a.titel} unterzeile={a.unterzeile} bild="mosque-square-nacht-platz" bildAlt={tx.alt['mosque-square-nacht-platz']} bildFormat="16 / 10" />

  <section class="abschnitt hell" aria-labelledby="intro-titel">
    <div class="huelle">
      <Abschnittskopf titel={a.introTitel} nummer={1} id="intro-titel" />
      <p class="einleitung lesetext einblenden">{a.intro}</p>
      <div class="schritte">
      <Abschnittskopf titel={a.schritteTitel} nummer={2} id="schritte-titel" />
      <Ablauf lang={lang} variante="voll" />
      <p class="mehr"><a class="textlink" href={pfad(lang, 'projects')}>{tx.start.projekteLink}</a></p>
      </div>
    </div>
  </section>

  <Kontaktaufruf lang={lang} nummer={3} hell={false} />
</Basis>

<style>
  .schritte { margin-block-start: var(--abschnitt-abstand); }
  .mehr { margin-block-start: var(--abstand-7); }
</style>
