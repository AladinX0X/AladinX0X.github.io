---
// Projekt-Detailseite: EIN gemeinsames Template für alle Projekte (Designsprache der Startseite).
// Hero (Vollbild oder geteilt; das Kartenbild morpht per transition:name hinein) → Eckdaten-Reihe + Beschreibung
// (Wort-Einblendung) → Materialien (+ Musterkarten nur bei Innenprojekten) → Galerie (filmisch) bzw. Plansatz
// (Werkplanung) bzw. Fallstudie (Identität) → vorheriges/nächstes Projekt als Bild-Teaser → Kontakt.
// Farbabschnitt: nur wenn das Projekt Farben hat UND keine Fallstudie ist (Außenprojekte und Werkplanung: keine Farben).
import Basis from '../../../layouts/Basis.astro';
import Hero from '../../../components/sections/Hero.astro';
import Abschnitt from '../../../components/sections/Abschnitt.astro';
import Eckdaten from '../../../components/sections/Eckdaten.astro';
import Galerie from '../../../components/sections/Galerie.astro';
import Musterkarten from '../../../components/sections/Musterkarten.astro';
import Plansatz from '../../../components/sections/Plansatz.astro';
import Fallstudie from '../../../components/sections/Fallstudie.astro';
import Teaser from '../../../components/sections/Teaser.astro';
import Raute from '../../../components/Raute.astro';
import Woerter from '../../../components/Woerter.astro';
import Lightbox from '../../../components/Lightbox.astro';
import Kontaktaufruf from '../../../components/Kontaktaufruf.astro';
import { projekte, leistungen, projektText, nachbarn, type Projekt } from '../../../data/daten';
import { t, pfad, fuelle, sprachen, type Sprache } from '../../../i18n/utils';

export function getStaticPaths() {
  return sprachen.flatMap((lang) => projekte.map((p) => ({ params: { lang, slug: p.slug }, props: { projekt: p } })));
}
interface Props { projekt: Projekt & { kapitel?: { muster: string; bilder: string[] }[] } }
const { projekt } = Astro.props;
const lang = Astro.params.lang as Sprache;
const tx = t(lang);
const p = tx.projekte;
const pt = projektText(projekt, lang) as ReturnType<typeof projektText> & { kapitel?: { titel: string; text: string }[] };
const { vorher, nachher } = nachbarn(projekt.slug);

// Eckdaten: nur vorhandene Angaben
const eckdaten = [
  { k: p.eckdaten.typ, v: pt.typ },
  { k: p.eckdaten.umfang, v: pt.umfang },
  { k: p.eckdaten.ort, v: pt.ort },
  { k: p.eckdaten.stil, v: pt.stil },
  { k: p.eckdaten.flaeche, v: projekt.flaeche ? fuelle(p.flaecheEinheit, { n: projekt.flaeche }) : null },
  { k: p.eckdaten.jahr, v: projekt.jahr ? String(projekt.jahr) : null },
].filter((e): e is { k: string; v: string } => Boolean(e.v));

const istFallstudie = Boolean(projekt.kapitel?.length && pt.kapitel?.length);
const istPlansatz = projekt.bereich === 'shop-drawings' && Boolean(pt.blaetter?.length);
const zeigtFarben = projekt.bereich === 'interior' && projekt.farben.length > 0 && Boolean(pt.farbnamen?.length);
// Lightbox: Titelbild zuerst, dann die Galerie (ohne Doppelung)
const galerie = projekt.galerie.filter((id) => id !== projekt.titelbild);
const lbIds = istPlansatz ? projekt.galerie : [projekt.titelbild, ...galerie];
const leistung = leistungen.find((l) => l.projekte.includes(projekt.slug) && l.slug !== '3d-visualization');
const leistungName = leistung ? tx.leistungen.eintraege[leistung.slug as keyof typeof tx.leistungen.eintraege].name : null;
// Fallstudie: Kapitel wechseln dunkel/hell; Teaser und Kontakt setzen den Wechsel fort
const endetDunkel = istFallstudie ? (((projekt.kapitel!.length - 1) % 2 === 0) === (pt.materialien.length === 0)) : false;
const teaserTon = istFallstudie && endetDunkel ? 'hell' : 'dunkel';
let nr = 0;
---
<Basis lang={lang} titel={pt.titel} beschreibung={`${pt.kurz} ${pt.beschreibung[0]}`.slice(0, 300)} seite="projekte" kopfUeberHero>
  <Hero
    bild={projekt.titelbild}
    bildAlt={pt.alt[projekt.titelbild]}
    variante={projekt.hero ?? 'auto'}
    kicker={p.filter[projekt.bereich]}
    titel={pt.titel}
    unterzeile={pt.kurz}
    transitionName={`projekt-bild-${projekt.slug}`}
    hinweisZiel="#beschreibung-titel"
    hinweisText={tx.start.scrollHinweis}
  />

  <Abschnitt ton="hell" id="beschreibung-titel" titel={p.beschreibung} nummer={++nr}>
    <Eckdaten titel={p.eckdatenTitel} eintraege={eckdaten} />
    <div class="beschreibung lesetext">
      {pt.beschreibung.map((absatz, i) => (i === 0
        ? <p class="einleitung" data-woerter-einblenden><Woerter text={absatz} /></p>
        : <p class="einblenden">{absatz}</p>))}
    </div>
    {leistung && leistungName && (
      <p class="mehr"><a class="textlink" href={pfad(lang, `services/${leistung.slug}`)}>{leistungName}</a></p>
    )}
  </Abschnitt>

  {(pt.materialien.length > 0 || zeigtFarben) && (
    <Abschnitt ton="dunkel" id="materialien-titel" titel={p.materialien} nummer={++nr}>
      <div class:list={['paletten', { 'mit-farben': zeigtFarben }]}>
        {pt.materialien.length > 0 && (
          <ul class="materialien">
            {pt.materialien.map((mat) => <li class="einblenden"><Raute />{mat}</li>)}
          </ul>
        )}
        {zeigtFarben && (
          <Musterkarten farben={projekt.farben} namen={pt.farbnamen!} titel={p.muster} hinweis={p.musterHinweis} id="farben-titel" />
        )}
      </div>
    </Abschnitt>
  )}

  {istFallstudie && (
    <Fallstudie
      kapitel={projekt.kapitel!}
      texte={pt.kapitel!}
      alts={pt.alt}
      farben={projekt.farben}
      farbnamen={pt.farbnamen ?? []}
      schriftprobe={p.schriftprobe}
      vergroessern={p.lightbox.vergroessern}
      startTon={pt.materialien.length > 0 ? 'hell' : 'dunkel'}
      lightboxIds={lbIds}
    />
  )}

  {istPlansatz && (
    <Abschnitt ton="hell" id="plansatz-titel" titel={p.plansatz} nummer={++nr} unterzeile={p.plansatzIntro}>
      <Plansatz ids={projekt.galerie} namen={pt.blaetter!} alts={pt.alt} projekt={pt.titel} blatt={p.blatt} planname={p.planname} vergroessern={p.lightbox.vergroessern} startIndex={0} />
    </Abschnitt>
  )}

  {!istFallstudie && !istPlansatz && galerie.length > 0 && (
    <Abschnitt ton="hell" id="galerie-titel" titel={p.galerie} nummer={++nr}>
      <Galerie ids={galerie} alts={pt.alt} vergroessern={p.lightbox.vergroessern} startIndex={1} />
    </Abschnitt>
  )}

  <Teaser lang={lang} vorher={vorher} nachher={nachher} vorherText={p.vorheriges} nachherText={p.naechstes} titel={p.teaserTitel} alleText={p.alle} ton={teaserTon} />


  <Kontaktaufruf lang={lang} hell={teaserTon === 'dunkel'} />
  <Lightbox lang={lang} ids={lbIds} alts={pt.alt} />
</Basis>

<style>
  .beschreibung { margin-block-start: var(--abstand-7); }
  .mehr { margin-block-start: var(--abstand-6); }
  .paletten { display: grid; gap: var(--abstand-8); }
  @media (min-width: 62rem) { .mit-farben { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); align-items: start; } }
  .materialien { list-style: none; display: grid; gap: var(--abstand-3); grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); font-size: var(--text-gross); }
  .mit-farben .materialien { grid-template-columns: 1fr; }
  .materialien li { display: flex; gap: var(--abstand-3); align-items: baseline; padding-block: var(--abstand-3); border-block-end: 1px solid var(--linie-auf-dunkel); }
  .materialien :global(.raute) { inline-size: 0.55em; flex: none; }
</style>
