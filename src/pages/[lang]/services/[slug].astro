---
// Leistungs-Detailseite (gemeinsames Template, Designsprache der Startseite):
// Hero → Was die Leistung umfasst → Ablauf (Linien-Szene) → Verwandte Projekte (Karten der Startseite)
// → Weitere Leistungen → Kontakt. Dunkel/hell wechseln sich automatisch ab.
import Basis from '../../../layouts/Basis.astro';
import Hero from '../../../components/sections/Hero.astro';
import Abschnitt from '../../../components/sections/Abschnitt.astro';
import LinienSzene from '../../../components/sections/LinienSzene.astro';
import Projektkarte from '../../../components/Projektkarte.astro';
import LeistungenListe from '../../../components/LeistungenListe.astro';
import Raute from '../../../components/Raute.astro';
import Icon from '../../../components/Icon.astro';
import Woerter from '../../../components/Woerter.astro';
import Kontaktaufruf from '../../../components/Kontaktaufruf.astro';
import { leistungen, projektNach, altText, type Leistung } from '../../../data/daten';
import { t, pfad, sprachen, type Sprache } from '../../../i18n/utils';

export function getStaticPaths() {
  return sprachen.flatMap((lang) => leistungen.map((l) => ({ params: { lang, slug: l.slug }, props: { leistung: l } })));
}
interface Props { leistung: Leistung }
const { leistung } = Astro.props;
const lang = Astro.params.lang as Sprache;
const tx = t(lang);
const l = tx.leistungen;
const e = l.eintraege[leistung.slug as keyof typeof l.eintraege];
const verknuepft = leistung.projekte.map(projektNach).filter((p) => p !== undefined);
// Werkplanung hat einen eigenen Ablauf (Design Intent → Development → Documentation → Detail), sonst die Arbeitsweise
const alsAbfolge = leistung.slug === 'shop-drawings';
const ablauf = alsAbfolge ? e.aspekte : tx.arbeitsweise.schritte;
// Abschnitte im Wechsel: Hero (dunkel) → hell → dunkel → …
const toene = ['hell', 'dunkel'] as const;
let n = 0;
const naechsterTon = () => toene[n++ % 2];
const tonUmfang = naechsterTon();
const tonAblauf = naechsterTon();
const tonProjekte = verknuepft.length > 0 ? naechsterTon() : null;
const tonWeitere = naechsterTon();
const tonKontakt = naechsterTon();
let nr = 0;
---
<Basis lang={lang} titel={e.name} beschreibung={e.kurz} seite="leistungen" kopfUeberHero vorladen={{ id: leistung.bild, sizes: '100vw' }}>
  <Hero bild={leistung.bild} bildAlt={altText(leistung.bild, lang)} kicker={l.titel} titel={e.name} unterzeile={e.kurz} hoehe="gross" hinweisZiel="#umfang-titel" hinweisText={tx.start.scrollHinweis} />

  <Abschnitt ton={tonUmfang} id="umfang-titel" titel={l.umfangTitel} nummer={++nr}>
    <div class="umfang">
      <div class="lesetext">
        {e.text.map((absatz, i) => (i === 0
          ? <p class="einleitung" data-woerter-einblenden><Woerter text={absatz} /></p>
          : <p>{absatz}</p>))}
      </div>
      {!alsAbfolge && (
        <ul class="aspekte">
          {e.aspekte.map((a) => (
            <li class="aspekt einblenden">
              <span class="icon-rund"><Icon name={leistung.icon} /></span>
              <h3><Raute />{a.name}</h3>
              <p>{a.text}</p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </Abschnitt>

  <LinienSzene ton={tonAblauf} titel={alsAbfolge ? l.schritteTitel : l.ablaufTitel} nummer={++nr} id="ablauf-titel" schritte={ablauf} link={alsAbfolge ? undefined : { href: pfad(lang, 'approach'), text: tx.start.arbeitsweiseLink }} />

  {tonProjekte && (
    <Abschnitt ton={tonProjekte} id="projekte-titel" titel={l.projekteTitel} nummer={++nr}>
      <div class="projekt-raster">
        {verknuepft.map((p) => <Projektkarte lang={lang} projekt={p} />)}
      </div>
    </Abschnitt>
  )}

  <Abschnitt ton={tonWeitere} id="weitere-titel" titel={l.weitere} nummer={++nr}>
    <LeistungenListe lang={lang} ausser={leistung.slug} />
  </Abschnitt>

  <Kontaktaufruf lang={lang} hell={tonKontakt === 'hell'} />
</Basis>

<style>
  .umfang { display: grid; gap: var(--abstand-8); }
  .aspekte { list-style: none; display: grid; gap: var(--abstand-6); grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .aspekt { display: grid; gap: var(--abstand-3); align-content: start; padding: var(--abstand-6); border: 1px solid var(--linie-auf-hell); border-radius: var(--radius-bild); }
  :global(.dunkel) .aspekt { border-color: var(--linie-auf-dunkel); }
  .aspekt h3 { display: flex; gap: var(--abstand-3); align-items: baseline; font-size: var(--h3); }
  .aspekt h3 :global(.raute) { inline-size: 0.5em; }
  .aspekt p { font-size: var(--text-klein); line-height: var(--zeile-klein); }
  .icon-rund { display: grid; place-items: center; inline-size: 3rem; block-size: 3rem; border-radius: 50%; border: 1px solid var(--farbe-terrakotta); color: var(--farbe-terrakotta-dunkel); }
  :global(.dunkel) .icon-rund { color: var(--farbe-terrakotta-hell); }
  .icon-rund :global(.icon) { inline-size: 1.4rem; block-size: 1.4rem; }
  .projekt-raster { display: grid; gap: var(--abstand-7) var(--abstand-6); grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
</style>
