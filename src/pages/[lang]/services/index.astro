---
// Leistungen – Übersicht (Designsprache der Startseite): Hero → Sticky-Liste (großes Bild wechselt beim Scrollen
// durch die Titel; Scroll-Moment) → Aussage "erfahrene Ingenieure" → Kontakt.
import Basis from '../../../layouts/Basis.astro';
import Hero from '../../../components/sections/Hero.astro';
import Abschnitt from '../../../components/sections/Abschnitt.astro';
import StickyListe from '../../../components/sections/StickyListe.astro';
import Statement from '../../../components/sections/Statement.astro';
import Icon from '../../../components/Icon.astro';
import Kontaktaufruf from '../../../components/Kontaktaufruf.astro';
import { leistungen, altText } from '../../../data/daten';
import { t, pfad, sprachPfade, type Sprache } from '../../../i18n/utils';

export const getStaticPaths = sprachPfade;
const lang = Astro.params.lang as Sprache;
const tx = t(lang);
const l = tx.leistungen;
const heroBild = 'villa-interior-uae-essbereich';
const eintraege = leistungen.map((x) => {
  const e = l.eintraege[x.slug as keyof typeof l.eintraege];
  return { titel: e.name, text: e.kurz, href: pfad(lang, `services/${x.slug}`), mehr: l.mehr, bild: x.bild, alt: altText(x.bild, lang), icon: x.icon };
});
---
<Basis lang={lang} titel={tx.meta.seiten.leistungen.titel} beschreibung={tx.meta.seiten.leistungen.beschreibung} seite="leistungen" kopfUeberHero vorladen={{ id: heroBild, sizes: '100vw' }}>
  <Hero bild={heroBild} bildAlt={altText(heroBild, lang)} kicker={tx.marke.unterzeile} titel={l.titel} unterzeile={l.unterzeile} hoehe="gross" hinweisZiel="#liste-titel" hinweisText={tx.start.scrollHinweis} />

  <Abschnitt ton="hell" id="liste-titel" titel={l.listeTitel} nummer={1} unterzeile={l.intro} szene="leistungen">
    <StickyListe eintraege={eintraege} />
  </Abschnitt>

  <Statement titel={tx.start.ingenieureTitel} text={tx.start.ingenieureText} id="ingenieure-titel">
    <p class="mehr"><a class="textlink" href={pfad(lang, 'projects')}>{tx.start.projekteLink}<Icon name="pfeil" klasse="spiegeln pfeil" /></a></p>
  </Statement>

  <Kontaktaufruf lang={lang} />
</Basis>

<style>
  .mehr { margin-block-start: var(--abstand-6); }
  .mehr :global(.pfeil) { display: inline-block; inline-size: 1.1em; block-size: 1.1em; vertical-align: -0.2em; margin-inline-start: 0.35em; }
</style>
