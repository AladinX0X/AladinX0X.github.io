---
// Studio (Designsprache der Startseite): Hero → Statement mit Wort-Einblendung → "Von der Zeichnung zur Erfahrung"
// (Linien-Szene) → Disziplinen als große Bildflächen → hervorgehobene Aussage "erfahrene Ingenieure" + Gründung → Kontakt.
import Basis from '../../layouts/Basis.astro';
import Hero from '../../components/sections/Hero.astro';
import Abschnitt from '../../components/sections/Abschnitt.astro';
import WortSzene from '../../components/sections/WortSzene.astro';
import LinienSzene from '../../components/sections/LinienSzene.astro';
import Panele from '../../components/sections/Panele.astro';
import Statement from '../../components/sections/Statement.astro';
import PortfolioKnopf from '../../components/PortfolioKnopf.astro';
import Kontaktaufruf from '../../components/Kontaktaufruf.astro';
import site from '../../data/site.json';
import { altText } from '../../data/daten';
import { t, pfad, fuelle, sprachPfade, type Sprache } from '../../i18n/utils';

export const getStaticPaths = sprachPfade;
const lang = Astro.params.lang as Sprache;
const tx = t(lang);
const u = tx.ueber;
const heroBild = 'villa-interior-uae-wohnzimmer-tv';
// Disziplinen als Bildflächen: Bilder aus den echten Projekten des jeweiligen Bereichs
const panelBilder = ['villa-homs-nacht-perspektive', 'villa-interior-uae-essbereich', 'brand-identity-cover'];
const panelLinks = ['exterior-architecture', 'interior-design', 'architectural-graphic-design'];
const panele = u.disziplinen.map((d, i) => ({
  bild: panelBilder[i], alt: altText(panelBilder[i], lang), titel: d.name, begriffe: d.begriffe,
  link: { href: pfad(lang, `services/${panelLinks[i]}`), text: tx.leistungen.mehr },
}));
---
<Basis lang={lang} titel={tx.meta.seiten.ueber.titel} beschreibung={tx.meta.seiten.ueber.beschreibung} seite="studio" kopfUeberHero vorladen={{ id: heroBild, sizes: '100vw' }}>
  <Hero bild={heroBild} bildAlt={altText(heroBild, lang)} kicker={tx.marke.unterzeile} titel={u.titel} unterzeile={u.unterzeile} hoehe="gross" hinweisZiel="#statement-titel" hinweisText={tx.start.scrollHinweis} />

  <WortSzene titel={u.verbundenTitel} nummer={1} id="statement-titel" text={u.intro} />

  <LinienSzene titel={u.ketteTitel} nummer={2} id="kette-titel" name="kette" unterzeile={u.ketteSatz} schritte={u.kette.map((name) => ({ name }))} />

  <Abschnitt ton="hell" id="disziplinen-titel" titel={u.disziplinenTitel} nummer={3}>
    <div class="lesetext verbunden einblenden">
      {u.verbundenText.map((absatz) => <p>{absatz}</p>)}
    </div>
    <Panele panele={panele} />
  </Abschnitt>

  <Statement titel={tx.start.ingenieureTitel} text={u.ingenieureText} id="ingenieure-titel" kastenTitel={u.gruendungTitel}>
    <Fragment slot="kasten">
      <p class="gruendung-jahr" aria-hidden="true">{site.gegruendet}</p>
      <p>{fuelle(u.gruendungText, { jahr: site.gegruendet })}</p>
      <PortfolioKnopf lang={lang} variante="linie" />
    </Fragment>
  </Statement>

  <Kontaktaufruf lang={lang} nummer={4} />
</Basis>

<style>
  .verbunden { margin-block-end: var(--abstand-8); font-size: var(--text-gross); }
  .gruendung-jahr { font-size: clamp(3rem, 2rem + 4vw, 5rem); font-weight: var(--gewicht-stark); line-height: 1; color: var(--farbe-elfenbein); font-variant-numeric: tabular-nums; }
</style>
