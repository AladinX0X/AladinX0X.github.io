---
// Kontakt: nur direkter Kontakt (kein Formular). Große Knöpfe für WhatsApp, Anruf und E-Mail,
// Social-Links, Kontaktdaten, Adresse und die Karte als Bild (Klick öffnet Google Maps im neuen Tab).
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Abschnittskopf from '../../components/Abschnittskopf.astro';
import Icon from '../../components/Icon.astro';
import Bild from '../../components/Bild.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import kontakt from '../../data/kontakt.json';
import { t, sprachPfade, type Sprache } from '../../i18n/utils';

export const getStaticPaths = sprachPfade;
const lang = Astro.params.lang as Sprache;
const tx = t(lang);
const k = tx.kontakt;
const daten = [
  { icon: 'telefon', titel: k.telefon, wert: kontakt.telefonAnzeige, href: kontakt.telefonLink, extern: false },
  { icon: 'email', titel: k.email, wert: kontakt.email, href: `mailto:${kontakt.email}`, extern: false },
  { icon: 'instagram', titel: k.instagram, wert: kontakt.instagramName, href: kontakt.instagram, extern: true },
];
---
<Basis lang={lang} titel={tx.meta.seiten.kontakt.titel} beschreibung={tx.meta.seiten.kontakt.beschreibung} seite="kontakt">
  <Seitenkopf titel={k.titel} unterzeile={k.unterzeile}>
    <div class="knopf-reihe gross-knoepfe">
      <a class="knopf knopf-voll" href={kontakt.whatsapp} target="_blank" rel="noopener" aria-label={`${k.buttonWhatsapp} (${k.neuesFenster})`}><Icon name="whatsapp" />{k.buttonWhatsapp}</a>
      <a class="knopf knopf-linie" href={kontakt.telefonLink}><Icon name="telefon" />{k.buttonAnruf}</a>
      <a class="knopf knopf-linie" href={`mailto:${kontakt.email}`}><Icon name="email" />{k.buttonEmail}</a>
    </div>
  </Seitenkopf>

  <section class="abschnitt hell" aria-labelledby="daten-titel">
    <div class="huelle zwei">
      <div class="spalte">
        <Abschnittskopf titel={k.datenTitel} nummer={1} id="daten-titel" />
        <ul class="daten">
          {daten.map((d) => (
            <li class="einblenden">
              <span class="icon-rund"><Icon name={d.icon} /></span>
              <span class="daten-text">
                <span class="daten-titel">{d.titel}</span>
                <a href={d.href} target={d.extern ? '_blank' : undefined} rel={d.extern ? 'noopener' : undefined}><bdi dir="ltr">{d.wert}</bdi></a>
              </span>
            </li>
          ))}
          <li class="einblenden">
            <span class="icon-rund"><Icon name="ort" /></span>
            <span class="daten-text">
              <span class="daten-titel">{k.adresse}</span>
              <address>{k.adresseZeilen.map((z) => <span>{z}</span>)}</address>
            </span>
          </li>
        </ul>
        <div class="social-block einblenden">
          <h3 class="social-titel">{k.socialTitel}</h3>
          <SocialLinks lang={lang} groesse="gross" />
        </div>
      </div>
      <div class="spalte">
        <Abschnittskopf titel={k.karteTitel} nummer={2} id="karte-ueberschrift" />
        <a class="karte bildrahmen einblenden" href={kontakt.googleMaps} target="_blank" rel="noopener" aria-label={`${k.karteOeffnen} (${k.neuesFenster})`}>
          <Bild id="kontakt-karte" alt={k.karteAlt} sizes="(min-width: 62rem) 46vw, 92vw" />
          <span class="karte-marke" aria-hidden="true"><Icon name="ort" />{k.karteLink}</span>
        </a>
        <p class="karte-link">
          <a class="knopf knopf-linie" href={kontakt.googleMaps} target="_blank" rel="noopener" aria-label={`${k.karteLink} (${k.neuesFenster})`}><Icon name="ort" />{k.karteLink}<Icon name="pfeil" klasse="spiegeln pfeil" /></a>
        </p>
      </div>
    </div>
  </section>
</Basis>

<style>
  .gross-knoepfe { margin-block-start: var(--abstand-4); }
  .gross-knoepfe .knopf { min-block-size: 3.75rem; font-size: var(--text); padding-inline: var(--abstand-7); }
  .gross-knoepfe .knopf :global(.icon) { inline-size: 1.5rem; block-size: 1.5rem; }
  .zwei { display: grid; gap: var(--abstand-8); grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); align-items: start; }
  .daten { list-style: none; display: grid; gap: var(--abstand-5); }
  .daten li { display: flex; gap: var(--abstand-4); align-items: center; }
  .icon-rund { display: grid; place-items: center; inline-size: 3rem; block-size: 3rem; flex: none; border-radius: 50%; background: var(--farbe-terrakotta-dunkel); color: var(--farbe-weiss); }
  .icon-rund :global(.icon) { inline-size: 1.4rem; block-size: 1.4rem; }
  .daten-text { display: grid; }
  .daten-titel { font-size: var(--text-klein); font-weight: var(--gewicht-titel); color: var(--farbe-terrakotta-dunkel); }
  .daten a { text-decoration: none; font-weight: var(--gewicht-mittel); }
  .daten a:hover { text-decoration: underline; text-underline-offset: 0.25em; }
  address { font-style: normal; display: grid; }
  .social-block { margin-block-start: var(--abstand-7); padding-block-start: var(--abstand-6); border-block-start: 1px solid var(--linie-auf-hell); }
  .social-titel { font-size: var(--h3); margin-block-end: var(--abstand-4); color: var(--farbe-terrakotta-dunkel); }

  /* Karte: ganzes Bild klickbar, Rahmen im Markenstil, Bild nicht beschnitten */
  .karte { position: relative; display: block; aspect-ratio: 2560 / 1569; text-decoration: none; }
  .karte :global(img) { transition: transform var(--dauer-lang) var(--kurve-ein); }
  .karte-marke {
    position: absolute;
    inset-block-end: var(--abstand-4);
    inset-inline-start: var(--abstand-4);
    display: inline-flex; align-items: center; gap: var(--abstand-2);
    padding: var(--abstand-2) var(--abstand-4);
    border-radius: var(--radius-knopf);
    background: var(--farbe-gruen);
    color: var(--farbe-elfenbein);
    font-size: var(--text-klein);
    font-weight: var(--gewicht-mittel);
  }
  .karte-marke :global(.icon) { inline-size: 1.1rem; block-size: 1.1rem; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .karte:hover :global(img) { transform: scale(1.03); }
  }
  .karte:focus-visible { outline-offset: 4px; }
  .karte-link { margin-block-start: var(--abstand-5); }
</style>
