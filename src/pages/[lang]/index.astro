---
// Startseite (freigegebene Referenz, siehe DESIGN-SYSTEM.md). Aufgebaut aus den gemeinsamen Bausteinen
// src/components/sections/*; Bewegung: src/scripts/motion/*.
import Basis from '../../layouts/Basis.astro';
import Hero from '../../components/sections/Hero.astro';
import Abschnitt from '../../components/sections/Abschnitt.astro';
import WortSzene from '../../components/sections/WortSzene.astro';
import BildSzene from '../../components/sections/BildSzene.astro';
import LinienSzene from '../../components/sections/LinienSzene.astro';
import Statement from '../../components/sections/Statement.astro';
import Kennzahlen from '../../components/Kennzahlen.astro';
import LeistungenListe from '../../components/LeistungenListe.astro';
import Disziplinen from '../../components/Disziplinen.astro';
import Projektkarte from '../../components/Projektkarte.astro';
import PortfolioKnopf from '../../components/PortfolioKnopf.astro';
import Icon from '../../components/Icon.astro';
import Kontaktaufruf from '../../components/Kontaktaufruf.astro';
import site from '../../data/site.json';
import { projektNach, projektText } from '../../data/daten';
import { t, pfad, sprachPfade, type Sprache } from '../../i18n/utils';

export const getStaticPaths = sprachPfade;
const lang = Astro.params.lang as Sprache;
const tx = t(lang);
// Das Hauptprojekt erscheint nicht zusätzlich als Karte (eindeutige transition:name)
const auswahl = site.ausgewaehlteProjekte.filter((s) => s !== site.hauptProjekt).map(projektNach).filter((p) => p !== undefined);
const haupt = projektNach(site.hauptProjekt);
if (!haupt) throw new Error(`hauptProjekt "${site.hauptProjekt}" fehlt in projekte.json`);
const hauptText = projektText(haupt, lang);
const heroProjekt = projektNach('mosque-square');
---
<Basis lang={lang} titel={tx.meta.seiten.start.titel} beschreibung={tx.meta.seiten.start.beschreibung} seite="start" ohneSuffix kopfUeberHero vorladen={{ id: site.heroBild, sizes: '100vw' }}>
  <Hero
    bild={site.heroBild}
    bildAlt={tx.alt.hero}
    variante={site.heroVollbild ? 'vollbild' : 'geteilt'}
    kicker={tx.marke.unterzeile}
    titel={tx.marke.claim}
    titelArt="claim"
    slogan={tx.marke.slogan}
    hinweisZiel="#studio-titel"
    hinweisText={tx.start.scrollHinweis}
    bildLink={heroProjekt ? { href: pfad(lang, `projects/${heroProjekt.slug}`), text: projektText(heroProjekt, lang).titel } : undefined}
  >
    <a class="knopf knopf-voll" href={pfad(lang, 'projects')}>{tx.start.heroProjekte}<Icon name="pfeil" klasse="spiegeln pfeil" /></a>
    <a class="knopf knopf-linie" href={pfad(lang, 'contact')}>{tx.start.heroKontakt}</a>
  </Hero>

  <WortSzene titel={tx.start.studioTitel} nummer={1} id="studio-titel" text={tx.start.studioText} link={{ href: pfad(lang, 'about'), text: tx.start.studioLink }} />

  <Abschnitt ton="dunkel" id="disziplinen-titel" titel={tx.start.disziplinenTitel} nummer={2} unterzeile={tx.start.disziplinenIntro}>
    <Disziplinen lang={lang} />
  </Abschnitt>

  <Abschnitt ton="hell" id="zahlen-titel" titel={tx.start.zahlenTitel} nummer={3}>
    <Kennzahlen lang={lang} />
  </Abschnitt>

  <BildSzene
    kicker={tx.start.hauptprojektKicker}
    nummer={4}
    titel={hauptText.titel}
    ort={hauptText.ort}
    bild={haupt.titelbild}
    bildAlt={hauptText.alt[haupt.titelbild]}
    text={hauptText.kurz}
    link={{ href: pfad(lang, `projects/${haupt.slug}`), text: tx.start.hauptprojektLink }}
  />

  <Abschnitt ton="hell" id="leistungen-titel" titel={tx.start.leistungenTitel} nummer={5} unterzeile={tx.start.leistungenIntro}>
    <LeistungenListe lang={lang} />
    <p class="mehr"><a class="textlink" href={pfad(lang, 'services')}>{tx.start.leistungenLink}<Icon name="pfeil" klasse="spiegeln pfeil" /></a></p>
  </Abschnitt>

  <LinienSzene
    titel={tx.start.arbeitsweiseTitel}
    nummer={6}
    unterzeile={tx.start.arbeitsweiseIntro}
    schritte={tx.arbeitsweise.schritte}
    link={{ href: pfad(lang, 'approach'), text: tx.start.arbeitsweiseLink }}
  />

  <Abschnitt ton="hell" id="projekte-titel" titel={tx.start.projekteTitel} nummer={7}>
    <div class="projekt-raster">
      {auswahl.map((p) => <Projektkarte lang={lang} projekt={p} />)}
    </div>
    <p class="mehr"><a class="textlink" href={pfad(lang, 'projects')}>{tx.start.projekteLink}<Icon name="pfeil" klasse="spiegeln pfeil" /></a></p>
  </Abschnitt>

  <Statement titel={tx.start.ingenieureTitel} text={tx.start.ingenieureText} id="ingenieure-titel" kastenTitel={tx.portfolio.titel}>
    <Fragment slot="kasten">
      <p>{tx.portfolio.text}</p>
      <PortfolioKnopf lang={lang} />
    </Fragment>
  </Statement>

  <Kontaktaufruf lang={lang} nummer={8} />
</Basis>

<style>
  .mehr { margin-block-start: var(--abstand-6); }
  .mehr :global(.pfeil) { display: inline-block; inline-size: 1.1em; block-size: 1.1em; vertical-align: -0.2em; margin-inline-start: 0.35em; }
  .projekt-raster { display: grid; gap: var(--abstand-7) var(--abstand-6); grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
</style>
