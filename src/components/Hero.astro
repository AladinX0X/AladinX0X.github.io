---
// Hero der Startseite. Vollbild (Original-Rendering) oder geteilt – Schalter: heroVollbild in src/data/site.json.
// Vollbild: Bild randlos, Text am Zeilenanfang über einem Verlauf (gemessen an der hellsten Stelle hinter dem Text,
// siehe BERICHT.md). Einstieg per CSS (global.css: Bild setzt sich 1.08 → 1, Wörter und Zeilen nacheinander), damit
// das größte Element (LCP) nicht auf JavaScript wartet. Scroll-Bewegung: src/scripts/module/bewegung.ts.
import Logo from './Logo.astro';
import Bild from './Bild.astro';
import Icon from './Icon.astro';
import Raute from './Raute.astro';
import Woerter from './Woerter.astro';
import site from '../data/site.json';
import kontakt from '../data/kontakt.json';
import { projektNach, projektText } from '../data/daten';
import { t, pfad, type Sprache } from '../i18n/utils';

interface Props { lang: Sprache }
const { lang } = Astro.props;
const tx = t(lang);
const vollbild = site.heroVollbild;
const projekt = projektNach('mosque-square');
---
<section class:list={['hero', 'dunkel', vollbild ? 'hero-vollbild' : 'hero-geteilt']} aria-labelledby="hero-titel" data-hero>
  <figure class="hero-bild">
    <div class="bildrahmen" data-hero-bild data-ueber-bild>
      <Bild id={site.heroBild} alt={tx.alt.hero} laden="eager" prioritaet sizes={vollbild ? '100vw' : '(min-width: 62rem) 30vw, 90vw'} />
    </div>
    {projekt && (
      <figcaption class:list={{ unsichtbar: vollbild }}><a class="textlink" href={pfad(lang, `projects/${projekt.slug}`)}>{projektText(projekt, lang).titel}</a></figcaption>
    )}
  </figure>
  {vollbild && <div class="hero-verlauf" aria-hidden="true"></div>}
  {vollbild && <div class="hero-schleier" data-hero-schleier aria-hidden="true"></div>}
  <div class="huelle hero-raster" data-hero-text>
    {!vollbild && (
      <div class="rahmen" aria-hidden="true">
        <span class="ecke ecke-start"><Raute /></span>
        <span class="ecke ecke-ende"><Raute /></span>
      </div>
    )}
    <div class="hero-text" data-ueber-bild>
      {vollbild
        ? <p class="hero-kicker" data-hero-intro style="--i: 0"><Raute /><span>{tx.marke.unterzeile}</span></p>
        : <div data-hero-intro style="--i: 0"><Logo variante="komplett-hell" breite={300} alt={tx.marke.name} klasse="hero-logo" /></div>}
      <h1 id="hero-titel" class="hero-claim" data-hero-woerter><Woerter text={tx.marke.claim} /></h1>
      <p class="hero-slogan" data-hero-intro style="--i: 6">{tx.marke.slogan}</p>
      <div class="knopf-reihe" data-hero-intro style="--i: 7">
        <a class="knopf knopf-voll" href={pfad(lang, 'projects')}>{tx.start.heroProjekte}<Icon name="pfeil" klasse="spiegeln pfeil" /></a>
        <a class="knopf knopf-linie" href={kontakt.whatsapp} target="_blank" rel="noopener" aria-label={`${tx.start.heroWhatsapp} (${tx.kontakt.neuesFenster})`}><Icon name="whatsapp" />{tx.start.heroWhatsapp}</a>
      </div>
    </div>
  </div>
  {vollbild && (
    <a class="scroll-hinweis" href="#studio-titel" data-hero-hinweis>
      <span data-hero-intro style="--i: 8">{tx.start.scrollHinweis}</span>
      <span class="hinweis-linie" aria-hidden="true" data-hero-intro style="--i: 8"><span></span></span>
    </a>
  )}
</section>

<style>
  .hero { position: relative; isolation: isolate; padding-block: clamp(2.5rem, 1rem + 5vw, 5rem); }
  .hero-raster {
    position: relative;
    display: grid;
    gap: var(--abstand-7);
    align-items: center;
    padding: clamp(1.5rem, 0.5rem + 4vw, 4rem);
  }
  /* Feine Rahmenlinien mit Rauten an zwei Ecken, wie auf den Kapitelseiten */
  .rahmen { position: absolute; inset: 0; pointer-events: none; }
  .rahmen::before, .rahmen::after { content: ''; position: absolute; background: var(--linie-auf-dunkel); }
  .rahmen::before { inset-block-start: 0.6rem; inset-inline: 0 30%; block-size: 1px; }
  .rahmen::after { inset-block: 0 30%; inset-inline-start: 0.6rem; inline-size: 1px; }
  .ecke { position: absolute; display: grid; place-items: center; inline-size: 1.2rem; block-size: 1.2rem; }
  .ecke :global(.raute) { inline-size: 0.8rem; }
  .ecke-start { inset-block-start: 0; inset-inline-start: 0; }
  .ecke-ende { inset-block-end: 0; inset-inline-end: 0; }
  .hero-raster::before, .hero-raster::after { content: ''; position: absolute; background: var(--linie-auf-dunkel); pointer-events: none; }
  .hero-raster::before { inset-block-end: 0.6rem; inset-inline: 30% 0; block-size: 1px; }
  .hero-raster::after { inset-block: 30% 0; inset-inline-end: 0.6rem; inline-size: 1px; }

  .hero-text { display: grid; gap: var(--abstand-5); justify-items: start; max-inline-size: 38rem; }
  .hero-text :global(.hero-logo) { inline-size: clamp(12rem, 8rem + 12vw, 18.75rem); block-size: auto; margin-block-end: var(--abstand-4); }
  .hero-claim { font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem); font-weight: var(--gewicht-titel); line-height: var(--zeile-titel); }
  .hero-slogan { font-size: var(--text-gross); color: var(--farbe-terrakotta-hell); }
  .knopf-reihe { margin-block-start: var(--abstand-4); }

  .hero-bild { margin: 0; }
  .hero-bild figcaption { font-size: var(--text-klein); text-align: center; }

  /* Geteilte Variante (PDF-Auszug, Bild gerahmt in echter Größe) */
  .hero-geteilt { display: grid; }
  .hero-geteilt .hero-bild { order: 2; justify-self: center; display: grid; gap: var(--abstand-3); inline-size: min(100%, 332px); }
  @media (min-width: 62rem) {
    .hero-geteilt { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: center; }
  }

  /* Vollbild: Bild randlos unter dem Kopf, Text am Zeilenanfang */
  .hero-vollbild {
    min-block-size: 100svh;
    margin-block-start: calc(-1 * var(--kopf-hoehe));
    padding-block: calc(var(--kopf-hoehe) + 2rem) calc(var(--radius-abschnitt) + 3rem);
    display: grid;
    align-items: end;
    overflow: clip;
    background: var(--farbe-gruen-tief);
  }
  .hero-vollbild .hero-bild { position: absolute; inset: 0; z-index: -3; }
  .hero-vollbild .hero-bild .bildrahmen { position: absolute; inset: -4% 0 0; border: 0; border-radius: 0; background: var(--farbe-gruen-tief); }
  .hero-vollbild .hero-bild :global(img) { transform-origin: 50% 60%; }
  /* Verlauf hinter dem Text: zum Zeilenanfang und nach unten dunkel, oben für den Kopf leicht abgedunkelt.
     Hellste Stelle hinter dem Text gemessen: siehe BERICHT.md (Kontrast Elfenbein mind. 7:1). */
  .hero-verlauf {
    position: absolute; inset: 0; z-index: -2; pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(3 33 26 / 0.6) 0%, rgb(3 33 26 / 0) 20%),
      linear-gradient(to top, rgb(3 33 26 / 0.92) 0%, rgb(3 33 26 / 0.72) 22%, rgb(3 33 26 / 0.35) 40%, rgb(3 33 26 / 0) 58%),
      linear-gradient(var(--winkel-start), rgb(3 33 26 / 0.9) 0%, rgb(3 33 26 / 0.7) 36%, rgb(3 33 26 / 0) 68%);
  }
  /* Schmal: der Text liegt über fast der ganzen Bildbreite, also kräftiger von unten abdunkeln */
  @media (max-width: 47.99rem) {
    .hero-verlauf {
      background:
        linear-gradient(to bottom, rgb(3 33 26 / 0.7) 0%, rgb(3 33 26 / 0) 16%),
        linear-gradient(to top, rgb(3 33 26 / 0.96) 0%, rgb(3 33 26 / 0.9) 55%, rgb(3 33 26 / 0.55) 78%, rgb(3 33 26 / 0) 100%);
    }
  }
  .hero-schleier { position: absolute; inset: 0; z-index: -1; background: var(--farbe-gruen-tief); opacity: 0; pointer-events: none; }
  .hero-vollbild::before { display: none; }
  .hero-vollbild .hero-raster { inline-size: 100%; padding-block: 0; padding-inline: var(--rand); }
  .hero-vollbild .hero-raster::before, .hero-vollbild .hero-raster::after { display: none; }
  .hero-vollbild .hero-text { max-inline-size: 42rem; gap: var(--abstand-4); }
  .hero-vollbild .hero-claim { font-size: clamp(2rem, 1.2rem + 2.6vw, 3.25rem); }
  .hero-kicker {
    display: inline-flex; align-items: center; gap: var(--abstand-3);
    padding: var(--abstand-1) var(--abstand-4);
    border: 1px solid var(--linie-auf-dunkel);
    border-radius: var(--radius-knopf);
    background: rgb(3 33 26 / 0.6);
    font-size: var(--text-klein); font-weight: var(--gewicht-mittel); color: var(--farbe-elfenbein);
  }
  .hero-kicker :global(.raute) { inline-size: 0.7em; }
  :global(:lang(en)) .hero-kicker { text-transform: uppercase; letter-spacing: 0.08em; }

  .scroll-hinweis {
    position: absolute;
    inset-block-end: calc(var(--radius-abschnitt) + var(--abstand-4));
    inset-inline-end: var(--rand);
    display: grid; justify-items: center; gap: var(--abstand-2);
    font-size: var(--text-klein);
    text-decoration: none;
  }
  .hinweis-linie { position: relative; display: block; inline-size: 1px; block-size: 2.75rem; background: var(--linie-auf-dunkel); overflow: hidden; }
  .hinweis-linie span { position: absolute; inset: 0; background: var(--farbe-terrakotta-hell); transform: translateY(-100%); }
  @media (prefers-reduced-motion: no-preference) {
    .hinweis-linie span { animation: hinweis 2.4s var(--kurve-weich) infinite; }
  }
  @keyframes hinweis { 0% { transform: translateY(-100%); } 55% { transform: translateY(0); } 100% { transform: translateY(100%); } }
  @media (max-width: 40rem) { .scroll-hinweis { display: none; } }
</style>
