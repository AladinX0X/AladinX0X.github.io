---
// Kopf einer Unterseite: dunkles Band mit Raute, h1, Unterzeile und optional einem Bild.
import Raute from './Raute.astro';
import Bild from './Bild.astro';

interface Props {
  titel: string;
  unterzeile?: string;
  kicker?: string;
  kickerHref?: string;
  bild?: string;
  bildAlt?: string;
  bildFormat?: string;
}
const { titel, unterzeile, kicker, kickerHref, bild, bildAlt = '', bildFormat = '4 / 3' } = Astro.props;
---
<section class={`seitenkopf abschnitt dunkel ${bild ? 'mit-bild' : ''}`} aria-labelledby="seiten-titel">
  <div class="huelle raster">
    <div class="text">
      {kicker && (
        <p class="kicker akzent">
          {kickerHref ? <a href={kickerHref}>{kicker}</a> : kicker}
        </p>
      )}
      <h1 id="seiten-titel" class="gross"><Raute klasse="titel-raute" /><span>{titel}</span></h1>
      <span class="linie" aria-hidden="true"></span>
      {unterzeile && <p class="unterzeile">{unterzeile}</p>}
      <slot />
    </div>
    {bild && (
      <div class="bildrahmen kopf-bild" style={`aspect-ratio: ${bildFormat}`}>
        <Bild id={bild} alt={bildAlt} sizes="(min-width: 62rem) 40vw, 92vw" laden="eager" prioritaet />
      </div>
    )}
  </div>
</section>
<style>
  .seitenkopf { padding-block: clamp(3rem, 2rem + 4vw, 6rem); }
  .raster { display: grid; gap: var(--abstand-7); align-items: center; }
  @media (min-width: 62rem) { .mit-bild .raster { grid-template-columns: 1.1fr 1fr; } }
  .text { display: grid; gap: var(--abstand-4); justify-items: start; }
  .kicker { font-size: var(--text-klein); font-weight: var(--gewicht-mittel); }
  .kicker a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.3em; }
  h1 { display: flex; gap: var(--abstand-4); align-items: baseline; color: var(--farbe-terrakotta-hell); }
  h1 :global(.titel-raute) { inline-size: 0.42em; transform: translateY(0.05em); }
  .linie {
    display: block;
    inline-size: min(100%, 22rem);
    block-size: 1px;
    background: linear-gradient(var(--winkel-ende), var(--farbe-terrakotta), transparent);
  }
  .unterzeile { font-size: var(--text-gross); max-inline-size: var(--text-max); }
  .kopf-bild { inline-size: 100%; }
</style>
