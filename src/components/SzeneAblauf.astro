---
// Gepinnte Szene "Arbeitsweise" der Startseite: sechs Schritte entlang einer gestrichelten Linie.
// Ohne JavaScript, bei reduzierter Bewegung und mobil: Raster der Schritte, alles sichtbar.
// Groß mit Maus (Klasse .bewegt, gesetzt von bewegung.ts): die Raute wandert beim Scrollen die Linie entlang
// (in RTL von rechts nach links), die Schritte leuchten nacheinander auf.
import Abschnittskopf from './Abschnittskopf.astro';
import Raute from './Raute.astro';
import { t, pfad, type Sprache } from '../i18n/utils';

interface Props { lang: Sprache; nummer: number }
const { lang, nummer } = Astro.props;
const tx = t(lang);
const schritte = tx.arbeitsweise.schritte;
const nr = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="szene szene-ablauf dunkel" data-szene="ablauf" aria-labelledby="arbeitsweise-titel">
  <div class="huelle sa-innen">
    <Abschnittskopf titel={tx.start.arbeitsweiseTitel} nummer={nummer} id="arbeitsweise-titel" unterzeile={tx.start.arbeitsweiseIntro} />
    <div class="sa-leiste" data-ablauf-leiste aria-hidden="true">
      <span class="sa-linie"></span>
      <span class="sa-fuellung" data-ablauf-fuellung></span>
      <span class="sa-raute" data-ablauf-raute><Raute /></span>
    </div>
    <ol class="sa-schritte">
      {schritte.map((s, i) => (
        <li class="sa-schritt einblenden" data-ablauf-schritt>
          <span class="knoten" aria-hidden="true"><Raute /></span>
          <span class="nr">{nr(i)}</span>
          <h3 class="name">{s.name}</h3>
          <p class="text">{s.text}</p>
        </li>
      ))}
    </ol>
    <p class="mehr"><a class="textlink" href={pfad(lang, 'approach')}>{tx.start.arbeitsweiseLink}</a></p>
  </div>
</section>

<style>
  .szene-ablauf { position: relative; isolation: isolate; padding-block: var(--abschnitt-abstand); background: var(--farbe-gruen); color: var(--farbe-elfenbein); }
  .sa-schritte {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--abstand-7) var(--abstand-6);
  }
  .sa-schritt { position: relative; display: grid; gap: var(--abstand-2); align-content: start; padding-block-start: var(--abstand-6); }
  .sa-schritt::before {
    content: '';
    position: absolute;
    inset-block-start: 0.55rem;
    inset-inline: 1.4rem 0;
    border-block-start: 2px dashed var(--farbe-terrakotta);
    opacity: 0.7;
  }
  .knoten { position: absolute; inset-block-start: 0; inset-inline-start: 0; line-height: 0; }
  .knoten :global(.raute) { inline-size: 0.75rem; }
  .nr { font-size: var(--text-klein); color: var(--farbe-terrakotta-hell); font-weight: var(--gewicht-titel); }
  .name { font-size: var(--h3); }
  .text { font-size: var(--text-klein); line-height: var(--zeile-klein); max-inline-size: 22rem; }
  .sa-leiste { display: none; }
  .mehr { margin-block-start: var(--abstand-7); }

  /* Bewegte Fassung: eine durchgehende Linie über sechs Spalten, die Raute wandert */
  .bewegt { min-block-size: 100svh; display: grid; align-content: center; padding-block: var(--abstand-8); }
  .bewegt .sa-leiste { display: block; position: relative; block-size: 1.5rem; margin-block: var(--abstand-6) 0; }
  .sa-linie, .sa-fuellung {
    position: absolute;
    inset-block-start: 50%;
    inset-inline: calc(100% / 12);
    border-block-start: 2px dashed var(--linie-auf-dunkel);
  }
  .sa-fuellung { border-block-start: 2px solid var(--farbe-terrakotta); transform-origin: var(--ursprung-start); transform: scaleX(0); }
  :global([dir='rtl']) .sa-fuellung { --ursprung-start: 100% 50%; }
  :global([dir='ltr']) .sa-fuellung { --ursprung-start: 0% 50%; }
  .sa-raute {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: calc(100% / 12 - 0.7rem);
    inline-size: 1.4rem;
    margin-block-start: -1.15rem;
    line-height: 0;
    filter: drop-shadow(0 0 10px rgb(232 135 92 / 0.6));
  }
  .sa-raute :global(.raute) { inline-size: 1.4rem; }
  /* Spalten ohne Abstand, damit die Spaltenmitten genau auf den Knoten der Linie liegen (n/12, 3n/12 ...) */
  .bewegt .sa-schritte { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0; margin-block-start: var(--abstand-5); }
  .bewegt .sa-schritt { padding-block-start: 0; padding-inline: var(--abstand-3); text-align: center; justify-items: center; }
  .bewegt .sa-schritt::before, .bewegt .knoten { display: none; }
  .bewegt .sa-schritt.einblenden { opacity: 1; transform: none; transition: none; }
</style>
