---
// Eigene, schematische SVG-Karte (Stil Portfolio Seite 43): dunkle Straßen, alte Uhr von Homs,
// gestrichelter Terrakotta-Weg zum Bazar Mall, Markierung. Nicht maßstabsgetreu.
// Lage und Straßennamen sind in INHALTE-TODO.md zur Prüfung markiert.
// Karten werden nicht gespiegelt; nur die Beschriftung folgt der Sprache.
import { t, richtung, type Sprache } from '../i18n/utils';

interface Props { lang: Sprache }
const { lang } = Astro.props;
const k = t(lang).kontakt;
const dir = richtung(lang);
---
<figure class="karte">
  <svg viewBox="0 0 800 500" role="img" aria-labelledby="karte-titel karte-text" direction={dir}>
    <title id="karte-titel">{k.karteTitel}</title>
    <desc id="karte-text">{k.karteBeschreibung}</desc>
    <rect class="grund" x="0" y="0" width="800" height="500" />
    <!-- Häuserblöcke -->
    <g class="bloecke">
      <rect x="60" y="60" width="170" height="150" rx="6" />
      <rect x="260" y="60" width="140" height="150" rx="6" />
      <rect x="470" y="60" width="120" height="70" rx="6" />
      <rect x="620" y="60" width="130" height="150" rx="6" />
      <rect x="260" y="290" width="140" height="160" rx="6" />
      <rect x="470" y="290" width="280" height="160" rx="6" />
    </g>
    <!-- Altes Marktviertel -->
    <g class="souq">
      <rect x="60" y="290" width="170" height="160" rx="6" />
      <path d="M75 305h140M75 325h140M75 345h140M75 365h140M75 385h140M75 405h140M75 425h140" />
    </g>
    <!-- Straßen -->
    <g class="strassen">
      <path class="haupt" d="M20 250 H780" />
      <path class="neben" d="M245 20 V480" />
      <path class="neben" d="M435 20 V480" />
      <path class="neben" d="M605 20 V480" />
      <path class="neben" d="M435 170 H780" />
    </g>
    <!-- Weg von der Uhr zum Mall -->
    <path class="weg" d="M330 250 H435 V170 H520" />
    <!-- Moschee -->
    <g class="moschee" transform="translate(145 150)">
      <path d="M-26 22 V2 a26 22 0 0 1 52 0 V22 Z" />
      <path d="M0 -20 V-34" />
    </g>
    <!-- Alte Uhr -->
    <g class="uhr" transform="translate(330 250)">
      <circle r="20" />
      <path d="M0 -10 V0 L7 5" />
    </g>
    <!-- Bazar Mall mit Markierung -->
    <g class="mall">
      <rect x="490" y="140" width="80" height="60" rx="6" />
    </g>
    <g class="marke" transform="translate(530 132)">
      <path d="M0 0 C-14 -16 -18 -24 -18 -32 a18 18 0 0 1 36 0 c0 8 -4 16 -18 32 Z" />
      <circle cy="-32" r="6.5" />
    </g>
    <!-- Beschriftung -->
    <g class="text">
      <text x="330" y="300" text-anchor="middle" class="wichtig">{k.karte.uhr}</text>
      <text x="530" y="232" text-anchor="middle" class="wichtig">{k.karte.mall}</text>
      <text x="690" y="284" text-anchor="middle" class="strasse">{k.karte.quwatli}</text>
      <text x="145" y="120" text-anchor="middle">{k.karte.moschee}</text>
      <text x="145" y="478" text-anchor="middle">{k.karte.souq}</text>
    </g>
    <!-- Nordpfeil -->
    <g class="nord" transform="translate(745 455)">
      <path d="M0 -22 L9 6 L0 0 L-9 6 Z" />
      <text y="20" text-anchor="middle" direction="ltr">N</text>
    </g>
  </svg>
  <figcaption>{k.karteBeschreibung}</figcaption>
</figure>
<style>
  .karte { margin: 0; display: grid; gap: var(--abstand-3); }
  svg { inline-size: 100%; block-size: auto; border-radius: var(--radius-bild); border: var(--kontur); background: #fff6ea; }
  .grund { fill: #fff6ea; }
  .bloecke rect { fill: #f3e2cc; }
  .souq rect { fill: #ecd6bb; }
  .souq path { stroke: #d9bf9f; stroke-width: 2; }
  .strassen path { fill: none; stroke: var(--farbe-gruen); stroke-linecap: round; }
  .haupt { stroke-width: 18; }
  .neben { stroke-width: 9; opacity: 0.85; }
  .weg { fill: none; stroke: var(--farbe-terrakotta); stroke-width: 5; stroke-dasharray: 12 9; stroke-linecap: round; stroke-linejoin: round; }
  .moschee path { fill: var(--farbe-gruen); stroke: var(--farbe-gruen); stroke-width: 3; }
  .uhr circle { fill: var(--farbe-elfenbein); stroke: var(--farbe-terrakotta); stroke-width: 5; }
  .uhr path { fill: none; stroke: var(--farbe-gruen); stroke-width: 3.5; stroke-linecap: round; }
  .mall rect { fill: var(--farbe-elfenbein); stroke: var(--farbe-terrakotta); stroke-width: 4; }
  .marke path { fill: var(--farbe-terrakotta-dunkel); }
  .marke circle { fill: var(--farbe-weiss); }
  .text text { font-family: var(--schrift); font-size: 19px; font-weight: 600; fill: var(--farbe-gruen); paint-order: stroke; stroke: #fff6ea; stroke-width: 6px; stroke-linejoin: round; }
  .text .wichtig { font-size: 22px; font-weight: 750; }
  .text .strasse { font-size: 17px; }
  .nord path { fill: var(--farbe-gruen); }
  .nord text { font-family: var(--schrift); font-size: 15px; font-weight: 700; fill: var(--farbe-gruen); }
  figcaption { font-size: var(--text-klein); line-height: var(--zeile-klein); }
</style>
